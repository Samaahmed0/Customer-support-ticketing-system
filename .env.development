# Development — verbose logs, single worker, auto-reload inside containers.
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
DATABASE_URL=postgresql://ticketing:ticketing@postgres:5432/ticketing
RABBITMQ_USER=ticketing
RABBITMQ_PASS=ticketing
RABBITMQ_URL=amqp://ticketing:ticketing@rabbitmq:5672/

LOG_LEVEL=DEBUG
UVICORN_WORKERS=1
UVICORN_EXTRA_ARGS=--reload

TICKET_HOST_PORT=8001
SUPPORT_HOST_PORT=8002
REPORTING_HOST_PORT=8003
NOTIFICATION_HOST_PORT=8004
WEB_HOST_PORT=8080

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100
RABBITMQ_MANAGEMENT_PORT=15672

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
