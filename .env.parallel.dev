# Used only by scripts/run-all-envs.sh — different host ports to avoid collisions.
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
DATABASE_URL=postgresql://ticketing:ticketing@postgres:5432/ticketing
RABBITMQ_USER=ticketing
RABBITMQ_PASS=ticketing
RABBITMQ_URL=amqp://ticketing:ticketing@rabbitmq:5672/
LOG_LEVEL=DEBUG
UVICORN_WORKERS=1
UVICORN_EXTRA_ARGS=--reload
TICKET_HOST_PORT=18001
SUPPORT_HOST_PORT=18002
REPORTING_HOST_PORT=18003
NOTIFICATION_HOST_PORT=18004
WEB_HOST_PORT=18080
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
LOKI_HOST_PORT=13100
RABBITMQ_MANAGEMENT_PORT=15672
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
